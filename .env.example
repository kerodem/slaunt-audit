# Optional: download the public classification catalog from Supabase.
# Audit tool names, descriptions, schemas, and local configuration never leave
# the machine in this mode.
SLAUNT_SUPABASE_URL=https://your-project.supabase.co
SLAUNT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional override for the Slaunt MCP server installed into detected clients.
SLAUNT_MCP_URL=https://central-mcp-ccr-production.up.railway.app/mcp
